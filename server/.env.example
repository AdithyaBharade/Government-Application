# --- Database (Neon / any PostgreSQL) ---
# Pooled URL used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
# Direct (non-pooled) URL used by prisma db push / migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# --- Auth ---
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="12h"

# --- Gemini (https://aistudio.google.com/app/apikey) ---
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# --- Cloudflare R2 (optional – if empty, documents are stored in PostgreSQL) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# --- App ---
PORT=5050
# Comma-separated list of allowed frontend origins
CORS_ORIGIN="http://localhost:5173"
# Service guarantee (Sakala) for an income certificate, in calendar days
SLA_DAYS=21
